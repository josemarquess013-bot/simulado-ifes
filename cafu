<header>
    <h1>IFES • Simulados Digitais</h1>
    <p>Preparação para o processo seletivo • 4 provas • 40 questões</p>
</header>

<div class="container">

<!-- LOGIN -->
<section id="login" class="card">
    <h2>Entrar no sistema</h2>

    <p>
        Digite seu nome para salvar automaticamente seu progresso,
        respostas e notas neste navegador.
    </p>

    <input
        type="text"
        id="nome"
        placeholder="Digite seu nome"
    >

    <button class="btn" onclick="entrar()">
        Entrar
    </button>
</section>


<!-- MENU -->
<section id="menu" class="hidden">

    <div class="card">
        <h2 id="saudacao"></h2>

        <p id="progressoTexto"></p>

        <div class="progress-bar">
            <div class="progress" id="progresso"></div>
        </div>
    </div>

    <div class="card">
        <h2>Etapas</h2>

        <div class="provas" id="listaProvas"></div>
    </div>

</section>


<!-- PROVA -->
<section id="prova" class="hidden">

    <div class="timer">
        ⏱ Tempo restante:
        <span id="timer">01:00:00</span>
    </div>

    <div class="card">

        <h2 id="tituloProva"></h2>

        <p>
            Leia cada questão com atenção.
            São 40 questões.
        </p>

        <div id="questoes"></div>

        <br>

        <button class="btn" onclick="finalizarProva()">
            Finalizar prova
        </button>

    </div>

</section>


<!-- RESULTADO -->
<section id="resultado" class="hidden">

    <div class="card result-box">

        <h2>Resultado da prova</h2>

        <div class="nota" id="nota"></div>

        <h3 id="porcentagem"></h3>

        <p id="mensagemResultado"></p>

        <div class="progress-bar">
            <div class="progress" id="barraResultado"></div>
        </div>

    </div>


    <div class="card">

        <h2>Correção</h2>

        <div id="correcao"></div>

    </div>


    <div class="card">

        <button
            class="btn"
            id="proximaBtn"
            onclick="proximaProva()"
        >
            Confirmar e continuar
        </button>

        <button
            class="btn-secondary"
            onclick="voltarMenu()"
        >
            Voltar ao menu
        </button>

    </div>

</section>

</div>

<footer>
    Simulados de preparação • IFES
</footer>


