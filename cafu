<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Simulado IFES</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background:
        radial-gradient(circle at top left, #183b70 0%, transparent 35%),
        radial-gradient(circle at bottom right, #102d55 0%, transparent 35%),
        #07111f;
    color: #fff;
    min-height: 100vh;
}

button {
    font-family: inherit;
}

.hidden {
    display: none !important;
}

/* LOGIN */

#loginScreen {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.login-box {
    width: 100%;
    max-width: 450px;
    background: rgba(13, 27, 48, 0.95);
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 22px;
    padding: 40px;
    box-shadow: 0 20px 60px rgba(0,0,0,.45);
    text-align: center;
}

.logo {
    width: 80px;
    height: 80px;
    border-radius: 22px;
    background: linear-gradient(135deg, #2376d8, #17448b);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    font-size: 35px;
    font-weight: bold;
}

.login-box h1 {
    font-size: 30px;
    margin-bottom: 8px;
}

.login-box p {
    color: #9eacc1;
    margin-bottom: 30px;
}

.input {
    width: 100%;
    padding: 15px;
    background: #09182b;
    border: 1px solid #263c5b;
    border-radius: 12px;
    color: white;
    outline: none;
    font-size: 16px;
    margin-bottom: 15px;
}

.input:focus {
    border-color: #3185e8;
}

.primary-btn {
    width: 100%;
    padding: 15px;
    border: none;
    border-radius: 12px;
    background: linear-gradient(135deg, #2581e8, #1453a0);
    color: white;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: .2s;
}

.primary-btn:hover {
    transform: translateY(-2px);
    filter: brightness(1.1);
}

/* HEADER */

header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(5, 15, 28, .95);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255,255,255,.08);
}

.header-content {
    max-width: 1100px;
    margin: auto;
    padding: 15px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
}

.header-title {
    font-size: 20px;
    font-weight: bold;
}

.header-user {
    color: #91a4bf;
    font-size: 14px;
}

/* DASHBOARD */

.container {
    width: 100%;
    max-width: 1100px;
    margin: auto;
    padding: 35px 20px 60px;
}

.welcome {
    margin-bottom: 30px;
}

.welcome h2 {
    font-size: 30px;
    margin-bottom: 8px;
}

.welcome p {
    color: #91a4bf;
}

.tests {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
}

.test-card {
    background: rgba(13, 27, 48, .9);
    border: 1px solid #1d3554;
    border-radius: 18px;
    padding: 25px;
    transition: .2s;
}

.test-card:hover {
    transform: translateY(-3px);
    border-color: #2e76c8;
}

.test-number {
    color: #55a2ff;
    font-weight: bold;
    font-size: 13px;
    text-transform: uppercase;
    margin-bottom: 10px;
}

.test-card h3 {
    font-size: 22px;
    margin-bottom: 10px;
}

.test-card p {
    color: #91a4bf;
    line-height: 1.5;
    margin-bottom: 20px;
}

.test-info {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 20px;
}

.tag {
    background: #102743;
    color: #a8c9ed;
    padding: 7px 10px;
    border-radius: 8px;
    font-size: 12px;
}

.test-btn {
    width: 100%;
    padding: 13px;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    background: #1d65b5;
    color: white;
    font-weight: bold;
}

.test-btn:disabled {
    background: #263344;
    color: #68778a;
    cursor: not-allowed;
}

.status {
    margin-bottom: 15px;
    font-size: 13px;
    color: #67d391;
}

/* PROVA */

.exam-container {
    max-width: 900px;
    margin: auto;
    padding: 25px 20px 70px;
}

.exam-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    margin-bottom: 20px;
}

.progress-area {
    flex: 1;
}

.progress-text {
    color: #91a4bf;
    font-size: 14px;
    margin-bottom: 8px;
}

.progress-bar {
    width: 100%;
    height: 8px;
    background: #17263b;
    border-radius: 20px;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #267ee1, #59b0ff);
    transition: width .2s;
}

.timer {
    min-width: 125px;
    text-align: center;
    padding: 13px 15px;
    border-radius: 12px;
    background: #101f34;
    border: 1px solid #28405f;
    font-size: 18px;
    font-weight: bold;
    color: #7fc0ff;
}

.question-card {
    background: rgba(13, 27, 48, .96);
    border: 1px solid #1e3655;
    border-radius: 18px;
    padding: 30px;
}

.subject {
    display: inline-block;
    color: #6bb5ff;
    background: #102b4b;
    border-radius: 8px;
    padding: 7px 10px;
    font-size: 12px;
    font-weight: bold;
    margin-bottom: 18px;
}

.question {
    font-size: 21px;
    line-height: 1.5;
    margin-bottom: 25px;
}

.options {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.option {
    position: relative;
}

.option input {
    position: absolute;
    opacity: 0;
}

.option label {
    display: block;
    padding: 17px;
    border: 1px solid #29415f;
    background: #0b1b30;
    border-radius: 12px;
    cursor: pointer;
    transition: .2s;
    color: #d8e3f1;
}

.option label:hover {
    border-color: #3a8eea;
    background: #102743;
}

.option input:checked + label {
    border-color: #3e9bff;
    background: #12355b;
    box-shadow: 0 0 0 1px #3e9bff;
}

.option-letter {
    display: inline-flex;
    width: 30px;
    height: 30px;
    align-items: center;
    justify-content: center;
    background: #1a3150;
    border-radius: 7px;
    margin-right: 10px;
    font-weight: bold;
}

.exam-buttons {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    margin-top: 20px;
}

.nav-btn {
    padding: 13px 20px;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    font-weight: bold;
}

.prev-btn {
    background: #1a2b40;
    color: white;
}

.next-btn {
    background: #267bd7;
    color: white;
}

.finish-btn {
    background: #15945b;
    color: white;
}

/* RESULTADO */

.result-container {
    max-width: 900px;
    margin: auto;
    padding: 45px 20px 70px;
}

.result-card {
    background: rgba(13, 27, 48, .97);
    border: 1px solid #203b5c;
    border-radius: 22px;
    padding: 35px;
    text-align: center;
}

.result-icon {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: #123d2b;
    color: #55e39b;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 38px;
    margin: 0 auto 20px;
}

.result-card h2 {
    font-size: 30px;
    margin-bottom: 8px;
}

.result-subtitle {
    color: #91a4bf;
    margin-bottom: 30px;
}

.result-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 30px;
}

.result-stat {
    padding: 18px;
    background: #0a1a2e;
    border: 1px solid #203853;
    border-radius: 13px;
}

.result-stat strong {
    display: block;
    font-size: 25px;
    margin-bottom: 5px;
}

.result-stat span {
    color: #8294aa;
    font-size: 13px;
}

.correction {
    text-align: left;
    margin-top: 30px;
}

.correction h3 {
    margin-bottom: 15px;
}

.correction-item {
    border-radius: 12px;
    padding: 15px;
    margin-bottom: 10px;
    border: 1px solid;
}

.correction-item.correct {
    background: #0d2c20;
    border-color: #1b6947;
}

.correction-item.wrong {
    background: #351919;
    border-color: #713333;
}

.correction-item p {
    margin-top: 7px;
    color: #b8c6d8;
    line-height: 1.5;
}

.result-actions {
    display: flex;
    gap: 12px;
    margin-top: 30px;
}

.result-actions button {
    flex: 1;
}

/* RESPONSIVO */

@media (max-width: 750px) {
    .tests {
        grid-template-columns: 1fr;
    }

    .result-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .exam-top {
        flex-direction: column;
        align-items: stretch;
    }

    .timer {
        width: 100%;
    }

    .question-card {
        padding: 22px;
    }

    .question {
        font-size: 18px;
    }
}

@media (max-width: 500px) {
    .login-box {
        padding: 25px;
    }

    .exam-buttons {
        flex-direction: column;
    }

    .result-actions {
        flex-direction: column;
    }
}
</style>
</head>

<body>

<!-- LOGIN -->
<section id="loginScreen">
    <div class="login-box">
        <div class="logo">I</div>

        <h1>Simulado IFES</h1>
        <p>Prepare-se para a prova com simulados objetivos.</p>

        <input
            type="text"
            id="nameInput"
            class="input"
            placeholder="Digite seu nome"
            maxlength="40"
        >

        <button class="primary-btn" onclick="entrar()">
            Entrar no Simulado
        </button>
    </div>
</section>


<!-- APLICATIVO -->
<div id="app" class="hidden">

    <header>
        <div class="header-content">
            <div class="header-title">Simulado IFES</div>
            <div class="header-user" id="headerUser"></div>
        </div>
    </header>

    <!-- DASHBOARD -->
    <main id="dashboard" class="container">

        <div class="welcome">
            <h2>Olá, <span id="welcomeName"></span>!</h2>
            <p>Escolha uma prova para começar.</p>
        </div>

        <div class="tests" id="testsContainer"></div>

    </main>


    <!-- PROVA -->
    <main id="examScreen" class="exam-container hidden">

        <div class="exam-top">

            <div class="progress-area">
                <div class="progress-text" id="progressText">
                    Questão 1 de 40
                </div>

                <div class="progress-bar">
                    <div
                        class="progress-fill"
                        id="progressFill"
                        style="width: 2.5%;"
                    ></div>
                </div>
            </div>

            <div class="timer" id="timer">
                00:00
            </div>

        </div>

        <div class="question-card">

            <div class="subject" id="questionSubject">
                Português
            </div>

            <div class="question" id="questionText"></div>

            <div class="options" id="options"></div>

        </div>

        <div class="exam-buttons">

            <button
                class="nav-btn prev-btn"
                onclick="questaoAnterior()"
                id="prevBtn"
            >
                ← Anterior
            </button>

            <button
                class="nav-btn next-btn"
                onclick="proximaQuestao()"
                id="nextBtn"
            >
                Próxima →
            </button>

            <button
                class="nav-btn finish-btn hidden"
                onclick="finalizarProva()"
                id="finishBtn"
            >
                Finalizar prova
            </button>

        </div>

    </main>


    <!-- RESULTADO -->
    <main id="resultScreen" class="result-container hidden">

        <div class="result-card">

            <div class="result-icon">✓</div>

            <h2>Prova finalizada!</h2>

            <p class="result-subtitle" id="resultSubtitle"></p>

            <div class="result-grid">

                <div class="result-stat">
                    <strong id="resultPoints">0</strong>
                    <span>Pontos</span>
                </div>

                <div class="result-stat">
                    <strong id="resultCorrect">0</strong>
                    <span>Acertos</span>
                </div>

                <div class="result-stat">
                    <strong id="resultWrong">0</strong>
                    <span>Erros</span>
                </div>

                <div class="result-stat">
                    <strong id="resultPercent">0%</strong>
                    <span>Aproveitamento</span>
                </div>

            </div>

            <div class="result-stat" style="margin-bottom:20px;">
                <strong id="resultTime">00:00</strong>
                <span>Tempo total da prova</span>
            </div>

            <div class="correction">
                <h3>Correção das questões</h3>
                <div id="correctionList"></div>
            </div>

            <div class="result-actions">

                <button
                    class="nav-btn prev-btn"
                    onclick="voltarDashboard()"
                >
                    Voltar ao início
                </button>

                <button
                    class="nav-btn next-btn"
                    id="nextTestBtn"
                    onclick="proximaProva()"
                >
                    Próxima prova →
                </button>

            </div>

        </div>

    </main>

</div>


<script>

