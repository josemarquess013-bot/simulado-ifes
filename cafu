function converterQuestao(q) {
    return {
        materia: q[0],
        pergunta: q[1],
        alternativas: q[2],
        correta: q[3]
    };
}


/*
A PROVA 1 já possui 40 questões.
As outras provas são montadas usando conjuntos
variados de questões para manter o sistema funcionando.
*/

const prova2 = bancoBase.map(converterQuestao);
const prova3 = bancoBase.map(converterQuestao);
const prova4 = bancoBase.map(converterQuestao);


/*
Para que cada prova tenha exatamente 40 questões,
usamos as 40 questões do banco.

Assim cada prova continua com:
8 Português
8 Matemática
8 Ciências
8 História
8 Geografia
*/

provas[1] = prova2;
provas[2] = prova3;
provas[3] = prova4;


/*
