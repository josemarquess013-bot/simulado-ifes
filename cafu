/* =====================================================
   LOGIN
===================================================== */

function entrar() {

    const nome = document
        .getElementById("nome")
        .value
        .trim();

    if (!nome) {
        alert("Digite seu nome.");
        return;
    }

    usuario = nome;

    localStorage.setItem(
        "ifes_usuario",
        usuario
    );

    if (!dados.provas) {
        dados.provas = {};
    }

    salvar();

    mostrarMenu();
}


/* =====================================================
   SALVAR
===================================================== */

function salvar() {

    localStorage.setItem(
        "ifes_dados",
        JSON.stringify(dados)
    );
}


/* =====================================================
   MENU
===================================================== */

function mostrarMenu() {

    document
        .getElementById("login")
        .classList.add("hidden");

    document
        .getElementById("prova")
        .classList.add("hidden");

    document
        .getElementById("resultado")
        .classList.add("hidden");

    document
        .getElementById("menu")
        .classList.remove("hidden");

    document
        .getElementById("saudacao")
        .textContent =
        "Olá, " + usuario + "!";

    let concluidas = 0;

    for (let i = 0; i < 4; i++) {

        if (
            dados.provas[i] &&
            dados.provas[i].finalizada
        ) {
            concluidas++;
        }
    }

    document
        .getElementById("progressoTexto")
        .textContent =
        `Você concluiu ${concluidas}/4 provas.`;

    document
        .getElementById("progresso")
        .style.width =
        (concluidas / 4 * 100) + "%";


    const lista =
        document.getElementById("listaProvas");

    lista.innerHTML = "";


    for (let i = 0; i < 4; i++) {

        const anteriorLiberada =
            i === 0 ||
            (
                dados.provas[i - 1] &&
                dados.provas[i - 1].finalizada
            );

        const resultado =
            dados.provas[i];

        const div =
            document.createElement("div");

        div.className =
            "prova " +
            (!anteriorLiberada ? "locked" : "");


        let status = "";

        if (resultado && resultado.finalizada) {

            status = `
                <span class="badge ok">
                    Nota: ${resultado.nota}/40
                </span>
            `;

        } else if (!anteriorLiberada) {

            status = `
                <span class="badge">
                    🔒 Bloqueada
                </span>
            `;

        } else {

            status = `
                <span class="badge">
                    Disponível
                </span>
            `;
        }


        div.innerHTML = `
            <h3>Prova ${i + 1}</h3>

            <p>
                40 questões
            </p>

            ${status}

            <br><br>

            ${
                anteriorLiberada
                ?
                `
                <button
                    class="btn"
                    onclick="iniciarProva(${i})"
                >
                    ${
                        resultado &&
                        resultado.finalizada
                        ?
                        "Refazer"
                        :
                        "Iniciar"
                    }
                </button>
                `
                :
                ""
            }
        `;

        lista.appendChild(div);
    }
}


/* =====================================================
   INICIAR PROVA
===================================================== */

function iniciarProva(numero) {

    provaAtual = numero;

    document
        .getElementById("menu")
        .classList.add("hidden");

    document
        .getElementById("resultado")
        .classList.add("hidden");

    document
        .getElementById("prova")
        .classList.remove("hidden");


    document
        .getElementById("tituloProva")
        .textContent =
        `IFES • Prova ${numero + 1}`;


    respostas =
        dados.provas[numero]?.respostas
        ||
        new Array(40).fill(null);


    tempo = 3600;

    atualizarTimer();

    clearInterval(intervalo);

    intervalo =
        setInterval(() => {

            tempo--;

            atualizarTimer();

            if (tempo <= 0) {

                clearInterval(intervalo);

                finalizarProva();
            }

        }, 1000);


    mostrarQuestoes();
}


/* =====================================================
   TIMER
===================================================== */

function atualizarTimer() {

    const horas =
        Math.floor(tempo / 3600);

    const minutos =
        Math.floor(
            (tempo % 3600) / 60
        );

    const segundos =
        tempo % 60;


    document
        .getElementById("timer")
        .textContent =
        `${String(horas).padStart(2,"0")}:` +
        `${String(minutos).padStart(2,"0")}:` +
        `${String(segundos).padStart(2,"0")}`;
}


/* =====================================================
   MOSTRAR QUESTÕES
===================================================== */

function mostrarQuestoes() {

    const container =
        document.getElementById("questoes");

    container.innerHTML = "";


    provas[provaAtual]
        .forEach((questao, indice) => {

        const materia =
            questao[0];

        const pergunta =
            questao[1];

        const alternativas =
            questao[2];

        const div =
            document.createElement("div");

        div.className =
            "question";


        let html = `
            <h3>
                ${indice + 1}.
                <small>${materia}</small>
            </h3>

            <p>${pergunta}</p>
        `;


        alternativas.forEach(
            (alternativa, letra) => {

            const marcado =
                respostas[indice] === letra
                ? "checked"
                : "";


            html += `
                <label class="option">

                    <input
                        type="radio"
                        name="q${indice}"
                        value="${letra}"
                        ${marcado}

                        onchange="
                            salvarResposta(
                                ${indice},
                                ${letra}
                            )
                        "
                    >

                    ${String.fromCharCode(65 + letra)})
                    ${alternativa}

                </label>
            `;
        });


        div.innerHTML = html;

        container.appendChild(div);
    });
}


/* =====================================================
   SALVAR RESPOSTA
===================================================== */

function salvarResposta(
    questao,
    alternativa
) {

    respostas[questao] =
        alternativa;


    if (!dados.provas[provaAtual]) {

        dados.provas[provaAtual] = {};
    }


    dados.provas[provaAtual]
        .respostas =
        respostas;


    salvar();
}


/* =====================================================
   FINALIZAR
===================================================== */

function finalizarProva() {

    if (
        !confirm(
            "Tem certeza que deseja finalizar esta prova?"
        )
    ) {
        return;
    }


    clearInterval(intervalo);


    const banco =
        provas[provaAtual];


    let acertos = 0;

    let erros = [];


    banco.forEach(
        (questao, indice) => {

        const correta =
            questao[4];

        const marcada =
            respostas[indice];


        if (marcada === correta) {

            acertos++;

        } else {

            erros.push({
                numero: indice + 1,
                pergunta: questao[1],
                marcada: marcada,
                correta: correta,
                alternativas: questao[2]
            });
        }

    });


    const porcentagem =
        Math.round(
            (acertos / 40) * 100
        );


    dados.provas[provaAtual] = {

        respostas:
            respostas,

        acertos:
            acertos,

        nota:
            acertos,

        porcentagem:
            porcentagem,

        finalizada:
            true,

        erros:
            erros
    };


    salvar();


    mostrarResultado(
        acertos,
        porcentagem,
        erros
    );
}


/* =====================================================
   RESULTADO
===================================================== */

function mostrarResultado(
    acertos,
    porcentagem,
    erros
) {

    document
        .getElementById("prova")
        .classList.add("hidden");


    document
        .getElementById("resultado")
        .classList.remove("hidden");


    document
        .getElementById("nota")
        .textContent =
        `${acertos}/40`;


    document
        .getElementById("porcentagem")
        .textContent =
        `${porcentagem}% de aproveitamento`;


    let mensagem;


    if (porcentagem >= 90) {

        mensagem =
            "🔥 Excelente desempenho!";

    } else if (porcentagem >= 70) {

        mensagem =
            "🟢 Muito bom! Continue estudando.";

    } else if (porcentagem >= 50) {

        mensagem =
            "🟡 Bom começo, mas ainda há pontos para melhorar.";

    } else {

        mensagem =
            "🔴 Continue estudando e tente novamente.";
    }


    document
        .getElementById("mensagemResultado")
        .textContent =
        mensagem;


    document
        .getElementById("barraResultado")
        .style.width =
        porcentagem + "%";


    const correcao =
        document.getElementById("correcao");


    correcao.innerHTML = "";


    if (erros.length === 0) {

        correcao.innerHTML =
            `<div class="acerto">
                🎉 Você acertou todas as questões!
            </div>`;

    } else {

        erros.forEach(erro => {

            const marcou =
                erro.marcada === null ||
                erro.marcada === undefined
                ?
                "Não respondeu"
                :
                `${String.fromCharCode(
                    65 + erro.marcada
                )}) ${
                    erro.alternativas[
                        erro.marcada
                    ]
                }`;


            const correta =
                `${String.fromCharCode(
                    65 + erro.correta
                )}) ${
                    erro.alternativas[
                        erro.correta
                    ]
                }`;


            correcao.innerHTML += `

                <div class="erro">

                    <b>
                        Questão ${erro.numero}
                    </b>

                    <p>
                        ${erro.pergunta}
                    </p>

                    <p>
                        ❌ Sua resposta:
                        ${marcou}
                    </p>

                    <p>
                        ✅ Resposta correta:
                        ${correta}
                    </p>

                </div>
            `;
        });
    }


    const botao =
        document.getElementById("proximaBtn");


    if (provaAtual < 3) {

        botao.textContent =
            `Confirmar e ir para Prova ${provaAtual + 2}`;

    } else {

        botao.textContent =
            "🏆 Finalizar simulados";
    }
}


/* =====================================================
   PRÓXIMA PROVA
===================================================== */

function proximaProva() {

    if (provaAtual < 3) {

        iniciarProva(
            provaAtual + 1
        );

    } else {

        alert(
            "🎉 Parabéns! Você concluiu as 4 provas."
        );

        mostrarMenu();
    }
}


/* =====================================================
   VOLTAR AO MENU
===================================================== */

function voltarMenu() {

    clearInterval(intervalo);

    mostrarMenu();
}


/* =====================================================
   LOGIN AUTOMÁTICO
===================================================== */

if (usuario) {

    document
        .getElementById("login")
        .classList.add("hidden");

    mostrarMenu();

} else {

    document
        .getElementById("login")
        .classList.remove("hidden");
}

