====================================================
*/

let usuario = "";
let provaAtual = 0;
let questaoAtual = 0;

let respostas = [];
let inicioProva = null;
let timerInterval = null;
let tempoFinal = 0;


/*
====================================================
 LOGIN
====================================================
*/

function entrar() {

    const nome = document.getElementById("nameInput").value.trim();

    if (!nome) {
        alert("Digite seu nome para continuar.");
        return;
    }

    usuario = nome;

    localStorage.setItem("simulado_nome", usuario);

    document.getElementById("loginScreen").classList.add("hidden");
    document.getElementById("app").classList.remove("hidden");

    document.getElementById("headerUser").textContent =
        "Aluno: " + usuario;

    document.getElementById("welcomeName").textContent =
        usuario;

    carregarDashboard();
}


/*
====================================================
 DASHBOARD
====================================================
*/

function carregarDashboard() {

    document.getElementById("dashboard").classList.remove("hidden");
    document.getElementById("examScreen").classList.add("hidden");
    document.getElementById("resultScreen").classList.add("hidden");

    const container =
        document.getElementById("testsContainer");

    container.innerHTML = "";

    const progresso =
        JSON.parse(localStorage.getItem("simulado_progresso")) || {};

    for (let i = 0; i < 4; i++) {

        const concluida = progresso[i]?.concluida === true;

        const liberada =
            i === 0 || progresso[i - 1]?.concluida === true;

        const card = document.createElement("div");

        card.className = "test-card";

        let status = "";

        if (concluida) {
            status =
                `<div class="status">✓ Prova concluída</div>`;
        } else if (!liberada) {
            status =
                `<div class="status" style="color:#d49b65;">
                    🔒 Complete a prova anterior
                </div>`;
        }

        card.innerHTML = `

            <div class="test-number">
                SIMULADO ${i + 1}
            </div>

            <h3>Prova ${i + 1}</h3>

            <p>
                Simulado com questões de Português,
                Matemática, Ciências, História e Geografia.
            </p>

            <div class="test-info">
                <span class="tag">40 questões</span>
                <span class="tag">Objetiva</span>
                <span class="tag">Cronômetro</span>
            </div>

            ${status}

            <button
                class="test-btn"
                onclick="iniciarProva(${i})"
                ${!liberada ? "disabled" : ""}
            >
                ${concluida ? "Refazer prova" : "Começar prova"}
            </button>
        `;

        container.appendChild(card);
    }
}


/*
====================================================
 INICIAR PROVA
====================================================
*/

function iniciarProva(indice) {

    provaAtual = indice;
    questaoAtual = 0;

    respostas =
        new Array(provas[provaAtual].length).fill(null);

    inicioProva = Date.now();
    tempoFinal = 0;

    document.getElementById("dashboard")
        .classList.add("hidden");

    document.getElementById("resultScreen")
        .classList.add("hidden");

    document.getElementById("examScreen")
        .classList.remove("hidden");

    iniciarCronometro();
    mostrarQuestao();
}


/*
====================================================
 CRONÔMETRO
====================================================
*/

function iniciarCronometro() {

    clearInterval(timerInterval);

    timerInterval = setInterval(() => {

        const segundos =
            Math.floor((Date.now() - inicioProva) / 1000);

        document.getElementById("timer").textContent =
            formatarTempo(segundos);

    }, 1000);
}


function formatarTempo(segundos) {

    const horas = Math.floor(segundos / 3600);

    const minutos =
        Math.floor((segundos % 3600) / 60);

    const segundosRestantes =
        segundos % 60;

    if (horas > 0) {

        return (
            String(horas).padStart(2, "0") +
            ":" +
            String(minutos).padStart(2, "0") +
            ":" +
            String(segundosRestantes).padStart(2, "0")
        );

    }

    return (
        String(minutos).padStart(2, "0") +
        ":" +
        String(segundosRestantes).padStart(2, "0")
    );
}


/*
====================================================
 MOSTRAR QUESTÃO
====================================================
*/

function mostrarQuestao() {

    const questao =
        provas[provaAtual][questaoAtual];

    document.getElementById("questionSubject")
        .textContent = questao.materia;

    document.getElementById("questionText")
        .textContent =
        questaoAtual + 1 + ". " + questao.pergunta;

    document.getElementById("progressText")
        .textContent =
        `Questão ${questaoAtual + 1} de ${provas[provaAtual].length}`;

    const porcentagem =
        ((questaoAtual + 1) /
        provas[provaAtual].length) * 100;

    document.getElementById("progressFill")
        .style.width = porcentagem + "%";

    const options =
        document.getElementById("options");

    options.innerHTML = "";

    const letras = ["A", "B", "C", "D"];

    questao.alternativas.forEach((alternativa, index) => {

        const div =
            document.createElement("div");

        div.className = "option";

        const checked =
            respostas[questaoAtual] === index
            ? "checked"
            : "";

        div.innerHTML = `

            <input
                type="radio"
                name="alternativa"
                id="opcao_${index}"
                value="${index}"
                ${checked}
            >

            <label for="opcao_${index}">

                <span class="option-letter">
                    ${letras[index]}
                </span>

                ${alternativa}

            </label>
        `;

        options.appendChild(div);
    });

    document.querySelectorAll(
        'input[name="alternativa"]'
    ).forEach(input => {

        input.addEventListener("change", function() {

            respostas[questaoAtual] =
                Number(this.value);

        });

    });

    document.getElementById("prevBtn")
        .style.visibility =
        questaoAtual === 0 ? "hidden" : "visible";

    const ultima =
        questaoAtual === provas[provaAtual].length - 1;

    document.getElementById("nextBtn")
        .classList.toggle("hidden", ultima);

    document.getElementById("finishBtn")
        .classList.toggle("hidden", !ultima);
}


/*
====================================================
 NAVEGAÇÃO
====================================================
*/

function salvarRespostaAtual() {

    const selecionada =
        document.querySelector(
            'input[name="alternativa"]:checked'
        );

    if (selecionada) {

        respostas[questaoAtual] =
            Number(selecionada.value);

    }
}


function proximaQuestao() {

    salvarRespostaAtual();

    if (questaoAtual <
        provas[provaAtual].length - 1) {

        questaoAtual++;

        mostrarQuestao();
    }
}


function questaoAnterior() {

    salvarRespostaAtual();

    if (questaoAtual > 0) {

        questaoAtual--;

        mostrarQuestao();
    }
}


/*
====================================================
 FINALIZAR
====================================================
*/

function finalizarProva() {

    salvarRespostaAtual();

    const semResposta =
        respostas.filter(r => r === null).length;

    if (semResposta > 0) {

        const confirmar =
            confirm(
                `Você ainda possui ${semResposta} questão(ões) sem resposta.\n\nDeseja finalizar mesmo assim?`
            );

        if (!confirmar) {
            return;
        }
    }

    clearInterval(timerInterval);

    tempoFinal =
        Math.floor((Date.now() - inicioProva) / 1000);

    calcularResultado();
}


/*
====================================================
 RESULTADO
====================================================
*/

function calcularResultado() {

    let acertos = 0;

    const questoes =
        provas[provaAtual];

    questoes.forEach((questao, index) => {

        if (respostas[index] === questao.correta) {
            acertos++;
        }

    });

    const erros =
        questoes.length - acertos;

    const porcentagem =
        (acertos / questoes.length) * 100;

    const pontos =
        acertos;

    salvarResultado(
        acertos,
        erros,
        porcentagem,
        pontos,
        tempoFinal
    );

    document.getElementById("examScreen")
        .classList.add("hidden");

    document.getElementById("resultScreen")
        .classList.remove("hidden");

    document.getElementById("resultPoints")
        .textContent = pontos + "/40";

    document.getElementById("resultCorrect")
        .textContent = acertos;

    document.getElementById("resultWrong")
        .textContent = erros;

    document.getElementById("resultPercent")
        .textContent =
        porcentagem.toFixed(1) + "%";

    document.getElementById("resultTime")
        .textContent =
        formatarTempo(tempoFinal);

    document.getElementById("resultSubtitle")
        .textContent =
        `Prova ${provaAtual + 1} concluída por ${usuario}.`;

    mostrarCorrecao();

    atualizarBotaoProxima();
}


/*
====================================================
 SALVAR RESULTADO
====================================================
*/

function salvarResultado(
    acertos,
    erros,
    porcentagem,
    pontos,
    tempo
) {

    const progresso =
        JSON.parse(
            localStorage.getItem("simulado_progresso")
        ) || {};

    progresso[provaAtual] = {

        concluida: true,

        acertos: acertos,

        erros: erros,

        porcentagem: porcentagem,

        pontos: pontos,

        tempo: tempo,

        respostas: respostas

    };

    localStorage.setItem(
        "simulado_progresso",
        JSON.stringify(progresso)
    );
}


/*
====================================================
 CORREÇÃO
====================================================
*/

function mostrarCorrecao() {

    const lista =
        document.getElementById("correctionList");

    lista.innerHTML = "";

    const letras =
        ["A", "B", "C", "D"];

    provas[provaAtual].forEach(
        (questao, index) => {

        const acertou =
            respostas[index] === questao.correta;

        const item =
            document.createElement("div");

        item.className =
            "correction-item " +
            (acertou ? "correct" : "wrong");

        let respostaUsuario =
            respostas[index] !== null
            ? letras[respostas[index]] +
              ") " +
              questao.alternativas[
                  respostas[index]
              ]
            : "Não respondeu";

        const respostaCorreta =
            letras[questao.correta] +
            ") " +
            questao.alternativas[
                questao.correta
            ];

        item.innerHTML = `

            <strong>
                Questão ${index + 1}
                ${acertou ? "✓" : "✗"}
            </strong>

            <p>
                <b>Você marcou:</b>
                ${respostaUsuario}
            </p>

            <p>
                <b>Resposta correta:</b>
                ${respostaCorreta}
            </p>

        `;

        lista.appendChild(item);
    });
}


/*
====================================================
 BOTÃO PRÓXIMA PROVA
====================================================
*/

function atualizarBotaoProxima() {

    const botao =
        document.getElementById("nextTestBtn");

    if (provaAtual < 3) {

        botao.classList.remove("hidden");

        botao.textContent =
            `Ir para prova ${provaAtual + 2} →`;

    } else {

        botao.classList.add("hidden");
    }
}


function proximaProva() {

    if (provaAtual >= 3) {
        return;
    }

    iniciarProva(provaAtual + 1);
}


/*
====================================================
