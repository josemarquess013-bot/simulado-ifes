<title>IFES • Simulados Digitais</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: #080b14;
    color: #fff;
}

.hidden {
    display: none !important;
}

.container {
    width: 95%;
    max-width: 1100px;
    margin: auto;
}

header {
    background: linear-gradient(135deg, #8b101d, #d9283b);
    padding: 35px 20px;
    text-align: center;
    box-shadow: 0 10px 35px rgba(0,0,0,.4);
}

header h1 {
    margin: 0;
    font-size: 38px;
}

header p {
    margin-top: 10px;
    color: #eee;
}

.card {
    background: #111827;
    border: 1px solid #29344d;
    border-radius: 18px;
    padding: 25px;
    margin: 25px 0;
    box-shadow: 0 10px 30px rgba(0,0,0,.25);
}

input[type="text"] {
    width: 100%;
    padding: 14px;
    border-radius: 10px;
    border: 1px solid #35415e;
    background: #090e1b;
    color: white;
    margin: 10px 0 15px;
    outline: none;
}

button {
    border: none;
    border-radius: 10px;
    padding: 13px 20px;
    font-weight: bold;
    cursor: pointer;
    transition: .2s;
}

button:hover {
    transform: translateY(-2px);
}

.btn {
    background: #d7283c;
    color: white;
}

.btn:hover {
    background: #f0384d;
}

.btn-secondary {
    background: #29344d;
    color: white;
}

.provas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 15px;
}

.prova {
    background: #192238;
    border: 1px solid #303d5d;
    padding: 20px;
    border-radius: 15px;
}

.prova h3 {
    margin-top: 0;
}

.locked {
    opacity: .45;
}

.badge {
    display: inline-block;
    padding: 5px 10px;
    border-radius: 20px;
    font-size: 12px;
    background: #303d5d;
}

.badge.ok {
    background: #176b43;
}

.timer {
    position: sticky;
    top: 0;
    z-index: 20;
    background: #090d18;
    padding: 13px;
    text-align: right;
    font-weight: bold;
    color: #ff6575;
}

.question {
    padding: 22px 0;
    border-bottom: 1px solid #29344d;
}

.question h3 {
    margin-top: 0;
}

.option {
    display: block;
    background: #192238;
    border: 1px solid #303d5d;
    border-radius: 10px;
    padding: 13px;
    margin: 9px 0;
    cursor: pointer;
}

.option:hover {
    border-color: #d7283c;
}

.option input {
    margin-right: 10px;
}

.result-box {
    text-align: center;
}

.nota {
    font-size: 55px;
    font-weight: bold;
    color: #ff4358;
}

.progress-bar {
    width: 100%;
    height: 14px;
    background: #29344d;
    border-radius: 20px;
    overflow: hidden;
    margin: 15px 0;
}

.progress {
    height: 100%;
    background: linear-gradient(90deg, #b8192b, #ff4054);
    width: 0%;
}

.erro {
    background: #291923;
    border-left: 4px solid #e33a50;
    padding: 15px;
    margin: 10px 0;
    border-radius: 8px;
}

.acerto {
    background: #14291f;
    border-left: 4px solid #27c978;
    padding: 15px;
    margin: 10px 0;
    border-radius: 8px;
}

small {
    color: #9ba7c0;
}

footer {
    text-align: center;
    padding: 30px;
    color: #68738b;
}
</style>
</head>

